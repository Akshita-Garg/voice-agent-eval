tring"}}, "required": ["patient_name", "phone_number", "requested_date", "requested_time"], "title": "BookAppointmentArgs", "type": "object"}}}, {"type": "function", "function": {"name": "check_availability", "description": "Check open general-consultation slots.\n", "parameters": {"properties": {"requested_date": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Preferred date in YYYY-MM-DD format, if the caller gave one.", "title": "Requested Date"}}, "title": "CheckAvailabilityArgs", "type": "object"}}}]}
